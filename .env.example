# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# RAGFlow 配置
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# Redis 配置（任务队列持久化）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 日志级别
LOG_LEVEL=INFO

# SQLite 检查点路径（LangGraph 状态持久化）
SQLITE_CHECKPOINT_PATH=app/data/checkpoints.db

# 语义缓存配置（SentenceTransformer + Redis，提升搜索/知识库重复查询速度）
CACHE_TTL_SECONDS=3600            # 缓存有效期（秒），Tavily 和 RAGFlow 共用
CACHE_SIMILARITY_THRESHOLD=0.92   # cosine 相似度阈值，>= 此值视为命中

# ---- Harness Engineering：任务级预算(Autonomy Budget) ----
# 任一维度触达即触发软停止:break astream → 注入收尾指令让模型用已有信息产出阶段性成果
BUDGET_MAX_ITERATIONS=20          # 单次 run 最大 LLM 轮次（= LangGraph recursion_limit - 5 的软停止阈值）
BUDGET_MAX_RUNTIME_S=300          # 单次 run 最大墙钟预算（秒）
BUDGET_MAX_TOOL_CALLS=30          # 单次 run 最大工具调用次数（含子智能体内部）
BUDGET_MAX_TOKENS=80000           # 单次 run 最大累计 token（max_cost 本期延后,用此代理）

# ---- Harness Engineering：Recovery Engine ----
RECOVERY_MAX_RETRIES=3            # 瞬态错误指数退避重试上限
CIRCUIT_BREAKER_THRESHOLD=5       # 连续失败多少次后熔断外部服务（Tavily/RAGFlow/MySQL）
CIRCUIT_BREAKER_COOLDOWN_S=60     # 熔断器 open 状态冷却时长（秒），到期转 half-open 探活

# ---- Harness Engineering：Task-run 级 Trace ----
TRACE_MAX_RUNS=100                # Redis 近期窗口保留的 run 数（超出按时间淘汰）
TRACE_TTL_SECONDS=86400           # 单条 trace 保留时长（秒），默认 24h
